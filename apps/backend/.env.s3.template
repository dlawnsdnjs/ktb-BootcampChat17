# Copy this file to .env on an S3-backed backend deployment.
# Keep AWS access keys out of this file and attach an IAM Instance Profile instead.

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

MONGO_URI=mongodb://localhost:27017/bootcamp-chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ktb

# S3 deployment: selects S3Storage + S3FileService and enables presigned PUT APIs.
FILE_STORAGE_TYPE=s3
S3_BUCKET_NAME=ktb-chat-files-prod
AWS_REGION=ap-northeast-2
S3_DIRECT_UPLOAD_ENABLED=true

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-...
