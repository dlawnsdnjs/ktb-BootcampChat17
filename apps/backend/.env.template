# Copy this file to .env and adjust values for your environment

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

MONGO_URI=mongodb://localhost:27017/bootcamp-chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ktb

# Storage mode shared with the Frontend build: local or s3.
FILE_STORAGE_TYPE=local
FILE_UPLOAD_DIR=./uploads

# Required only when FILE_STORAGE_TYPE=s3.
S3_BUCKET_NAME=ktb-chat-files-prod
AWS_REGION=ap-northeast-2
# Local S3 development may fill in both keys. On EC2 leave them empty and use an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-...
